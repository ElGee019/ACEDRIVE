<Window x:Class="AceDrive.Overlay.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AceDrive HUD" Width="413.6" Height="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False">
    <!-- Same two-ring companion frame as MainWindow, fixed at 200 px high.
         The HUD is a separate top-level window on purpose: MainViewModel's
         show/hide only touches the main panel, so Ctrl+Shift+C can hide the
         menu while this stays visible over the game. -->
    <Border Background="#F214161A" CornerRadius="18" Padding="10">
        <Border BorderBrush="#FFFFFFFF" BorderThickness="2" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Errand destination or wrong-car warning (PORTPLAN
                     5/24/27): hidden until the birthday dialogue hands the
                     errand over, then pinned at the top while the player
                     drives. Parked on the destination house, the sentence
                     becomes the arrival line and the centered ENTER button
                     appears. While a car other than the garage's current car
                     is driven, the warning replaces the errand sentence in
                     this same slot and font. -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding BannerText}"
                               Foreground="#FFFFFFFF" FontSize="16"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}"/>
                    <Button x:Name="EnterButton" Grid.Row="1" Content="{Binding EnterText}"
                            Command="{Binding EnterCommand}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            FontSize="16" Padding="10,4"
                            Visibility="{Binding ShowEnterButton, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EnterFlash}" Value="True">
                                        <Setter Property="Foreground" Value="#FF97EAD2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding AddressLabel}"
                               Foreground="#FF999999" FontSize="11"/>
                    <TextBlock Text="{Binding AddressText}"
                               Foreground="#FFFFFFFF" FontSize="18"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Miles/kilometres sit beside the street; both rows bottom-align
                     on the inner border's 10 px padding, so the text clears the
                     white line by 10. -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding MileageLabel}" HorizontalAlignment="Right"
                               Foreground="#FF999999" FontSize="11"/>
                    <TextBlock Text="{Binding MileageText}" HorizontalAlignment="Right"
                               Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
