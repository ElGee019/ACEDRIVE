<Window x:Class="AceDrive.Overlay.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AceDrive.Overlay.ViewModels"
        xmlns:views="clr-namespace:AceDrive.Overlay.Views"
        Title="AceDrive HUD" Width="413.6" Height="200" MinHeight="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False">
    <!-- Same two-ring companion frame as MainWindow: a 200 px strip while
         driving, grown to the page's height while a customer request owns the
         frame (HudWindow.ApplyRequestSize). The HUD is a separate top-level
         window on purpose: MainViewModel's show/hide only touches the main
         panel, so Ctrl+Shift+C can hide the menu while this stays visible over
         the game. -->
    <Window.Resources>
        <!-- The customer request rides the companion (PORTPLAN 11): the same
             page VM the panel used, painted here instead so the ask is
             answered mid-drive without opening the main window. -->
        <DataTemplate DataType="{x:Type vm:CustomerRequestScreenViewModel}">
            <views:CustomerRequestScreenView/>
        </DataTemplate>
        <!-- A timed ask's delivery clock (the speed challenge or a
             passenger's hurry) uses the design's Tourney face, like the menu
             clock. A machine without the embedded font falls back to the
             default face rather than failing the HUD. -->
        <FontFamily x:Key="TourneyThin">pack://application:,,,/AceDrive.Overlay;component/Assets/Fonts/#Tourney Thin</FontFamily>
    </Window.Resources>
    <!-- The frame is the same black as the driving strip; the request page
         paints no backdrop of its own. -->
    <Border Background="#F214161A" CornerRadius="18" Padding="10">
        <Border BorderBrush="#FFFFFFFF" BorderThickness="2" CornerRadius="8" Padding="14,10">
            <Grid>
                <!-- Normal task text: the destination/wrong-car line, the
                     remaining distance or a notice, ENTER, the street and the
                     mileage. Hidden while a customer request owns the frame,
                     and its guidance block stays down once the player entered
                     the pinned door (the street and mileage keep updating). -->
                <Grid Visibility="{Binding HasNoRequest, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Destination or wrong-car warning (PORTPLAN 5/24/27):
                         hidden until the birthday dialogue hands the errand over,
                         then pinned at the top while the player drives. Parked on
                         the destination house, the sentence becomes the arrival
                         line and the centered ENTER button appears. While a car
                         other than the garage's current car is driven, the warning
                         replaces the destination line in this same slot and font. -->
                    <Grid Grid.Row="0" Grid.ColumnSpan="2"
                          Visibility="{Binding HasTaskText, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding BannerText}"
                                   Foreground="#FFFFFFFF" FontSize="16"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}"/>
                        <!-- Remaining distance to the pinned leg (a taxi job
                             or an intro drive) or a transient host notice
                             (police fine) over the speed-challenge clock. The
                             notice wins the distance line and turns it teal so
                             it reads as an event rather than guidance; the
                             clock keeps its own Tourney line. -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{Binding HudLineText}"
                                       FontSize="13" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasHudLine, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFCCCCCC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNotice}" Value="True">
                                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Live club reputation while a Cento Miglia race runs
                                 (PORTPLAN 49). It has its own line so the banner
                                 above stays the drive-to sentence: the counter
                                 must never cost the player the way to the finish. -->
                            <TextBlock Text="{Binding ReputationText}"
                                       FontFamily="{StaticResource TourneyThin}"
                                       FontSize="18" TextTrimming="CharacterEllipsis"
                                       Foreground="#FFFFFFFF"
                                       Visibility="{Binding HasReputation, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding DeadlineText}"
                                       FontFamily="{StaticResource TourneyThin}"
                                       FontSize="22" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasDeadline, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DeadlineLate}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFF9E64"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button x:Name="EnterButton" Grid.Row="2" Content="{Binding EnterText}"
                                Command="{Binding EnterCommand}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                FontSize="16" Padding="10,4"
                                Visibility="{Binding ShowEnterButton, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnterFlash}" Value="True">
                                            <Setter Property="Foreground" Value="#FF97EAD2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding AddressLabel}"
                                   Foreground="#FF999999" FontSize="11"/>
                        <TextBlock Text="{Binding AddressText}"
                                   Foreground="#FFFFFFFF" FontSize="18"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Miles/kilometres sit beside the street; both rows bottom-align
                         on the inner border's 10 px padding, so the text clears the
                         white line by 10. -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0"
                                VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding MileageLabel}" HorizontalAlignment="Right"
                                   Foreground="#FF999999" FontSize="11"/>
                        <TextBlock Text="{Binding MileageText}" HorizontalAlignment="Right"
                                   Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- Customer request: the ask, its options and the countdown,
                     replacing the task text for the duration of the ask. The
                     window sizes itself to this page (ApplyRequestSize), so a
                     tall quiz needs neither a scrollbar nor a taller magic
                     height. -->
                <ContentControl Content="{Binding Request}"
                                Visibility="{Binding HasRequest, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Border>
</Window>
