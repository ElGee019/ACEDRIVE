<Application x:Class="AceDrive.Overlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AceDrive.Overlay.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:BoolToHiddenConverter x:Key="BoolToHiddenVis"/>
        <!-- One shared thumbnail loader for every car image: the startup
             assigns its Source once, so the converter (a view helper) never
             touches the filesystem itself. -->
        <views:ImagePathConverter x:Key="ThumbnailImage"/>
        <!-- Embedded artwork (menu tiles): same loader seam as the thumbnails,
             but for pack URIs, so a WebP-less WIC drops the art instead of the
             app. The startup assigns its Source once. -->
        <views:PackImageConverter x:Key="PackImage"/>
        <!-- Battery tile fill: the meter fraction to the clip that reveals the
             gradient bottom up, one step per meter point. WHY "Clip" in the
             key: MenuScreenView has a local MeterFill Image style, and a shared
             key would shadow it (a Style where a converter is expected). -->
        <views:MeterFillConverter x:Key="MeterFillClip"/>
        <!-- Menu-tile voice acknowledgment: the shared teal glow around the
             artwork while its flash flag is up. -->
        <views:BoolToVoiceGlowConverter x:Key="VoiceGlow"/>
        <!-- One earnings row shape for both receipt pages (taxi + delivery):
             explanation and amount sit in their own column, both
             left-aligned. The SharedSizeGroup (scoped on the hosting body
             panel) lines every row of the block up on the same two columns;
             font size and colour inherit from the hosting element. -->
        <DataTemplate x:Key="ReceiptLineTemplate">
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ReceiptExplanation"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ReceiptAmount"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Explanation}"/>
                <TextBlock Grid.Column="1" Text="{Binding Amount}" Margin="10,0,0,0"/>
            </Grid>
        </DataTemplate>
        <!-- Section hairline: the wallet's 1 px white rule between its account
             rows and around its sections. Shared here so the receipt pages
             separate their XP block and standings pair with the same weight
             instead of copying the border declaration per page. Pages that
             need a tighter line override the margin locally. -->
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Margin" Value="0,12"/>
        </Style>
        <!-- Page title band: one style so every page renders its title at the
             same height, no matter how the body below it is aligned. -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Page body paragraph: the line under a page title. Second page needs
             it, so it lives here instead of being inlined twice. -->
        <Style x:Key="PageBody" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Stock fill bar (delivery page rows): the platform default paints
             chunky gradient chrome that fights the companion look, so a flat
             template. ProgressBar plumbing sizes PART_Indicator from
             Value/Maximum; the caller sets Foreground per stock band. -->
        <Style x:Key="StockBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#33FFFFFF" CornerRadius="2" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                        CornerRadius="2" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Companion look: transparent buttons, white outline, light wash on
             hover. Default chrome cannot round, so a minimal template with a
             bordered Border supplies the corner radius; TemplateBinding keeps
             the hover trigger below driving the fill. -->
        <Style TargetType="Button">
            <!-- Transparent fill so the backdrop shows through the button;
                 hover uses a light white wash instead of a dark fill so the
                 button never turns into a black box. -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <!-- Outline matches the edge line: fully opaque white, no alpha. -->
            <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- One form look for the setup pages (first-run + name/address): dim
             labels, dark fields. The ComboBox rides the same colours so the
             block reads as one card instead of platform chrome. Shared here
             so the two intro pages render identical fields (DRY). -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFBFC4C9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="FormField" TargetType="TextBox">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#FF3A4148"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#FF3A4148"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="6,2"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  IsHitTestVisible="False"
                                                                  TextElement.Foreground="#FFF"
                                                                  Content="{Binding SelectionBoxItem,
                                                                            RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                                                    RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat,
                                                                                        RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="▼"
                                                           Foreground="White"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="False"
                                   Focusable="False"
                                   StaysOpen="False"
                                   PopupAnimation="Fade"
                                   MinWidth="{TemplateBinding ActualWidth}"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="Black"
                                        BorderBrush="#FF3A4148"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The dropdown rows follow the same black card as the closed
             ComboBox; the default ComboBoxItem chrome is light. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#FF2A3138"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF2A3138"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
