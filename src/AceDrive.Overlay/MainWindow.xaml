<Window x:Class="AceDrive.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AceDrive.Overlay.ViewModels"
        xmlns:views="clr-namespace:AceDrive.Overlay.Views"
        Title="AceDrive" Width="413.6" Height="917.2"
        WindowStyle="None" AllowsTransparency="True" ShowActivated="False"
        Background="Transparent" Topmost="True"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" MinWidth="200" MinHeight="80">
    <!-- Standard panel: the home page's 1080 x 2280 design canvas mapped to
         the 413.6 width gives 873.2 for the page; the 44 px of border chrome
         around it (10 + 2 + 10 on each side) adds up to 917.2. At this size
         the whole home page fits, so no scrollbar shows until the player
         resizes the panel smaller. A saved size from a pre-standard layout
         (no placement Version) is grown to this once on startup. -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PreferencesScreenViewModel}">
            <views:PreferencesScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OpeningScreenViewModel}">
            <views:OpeningScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrandScreenViewModel}">
            <views:BrandScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GrandmaCarScreenViewModel}">
            <views:GrandmaCarScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VoiceInfoScreenViewModel}">
            <views:VoiceInfoScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DialogueScreenViewModel}">
            <views:DialogueScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MainControlScreenViewModel}">
            <views:MainControlScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MenuScreenViewModel}">
            <views:MenuScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeScreenViewModel}">
            <views:HomeScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddressesScreenViewModel}">
            <views:AddressesScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WalletScreenViewModel}">
            <views:WalletScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalendarScreenViewModel}">
            <views:CalendarScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CentoMigliaScreenViewModel}">
            <views:CentoMigliaScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrunkScreenViewModel}">
            <views:TrunkScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaxiJobProposalViewModel}">
            <views:TaxiJobProposalScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaxiReceiptScreenViewModel}">
            <views:TaxiReceiptScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftEndedScreenViewModel}">
            <views:ShiftEndedScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerRequestScreenViewModel}">
            <views:CustomerRequestScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeliveryJobScreenViewModel}">
            <views:DeliveryJobScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeliveryHubScreenViewModel}">
            <views:DeliveryHubScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeliveryReceiptScreenViewModel}">
            <views:DeliveryReceiptScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CarHaulReceiptScreenViewModel}">
            <views:CarHaulReceiptScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BankScreenViewModel}">
            <views:BankScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GarageScreenViewModel}">
            <views:GarageScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DealerScreenViewModel}">
            <views:DealerScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoughtFirstCarScreenViewModel}">
            <views:BoughtFirstCarScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CarWashScreenViewModel}">
            <views:CarWashScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MechanicScreenViewModel}">
            <views:MechanicScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StoreScreenViewModel}">
            <views:StoreScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InsuranceScreenViewModel}">
            <views:InsuranceScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BreakdownScreenViewModel}">
            <views:BreakdownScreenView/>
        </DataTemplate>
    </Window.Resources>
    <!-- Two rings: the outer Border paints the background, its Padding pushes
         the edge line 10 px inward so the dark fill frames it. The window fill
         is transparent because an opaque window background would square off the
         rounded corners behind both rings.
         The dark fill is the fallback: the WebP backdrop is applied in code
         (MainWindow.ApplyBackdrop) because a XAML ImageSource would render-
         thread-crash on machines whose WIC has no WebP codec (older Win10). -->
    <Border x:Name="Backdrop" Background="#F214161A" CornerRadius="18" Padding="10">
        <Border BorderBrush="#FFFFFFFF" BorderThickness="2" CornerRadius="8" Padding="10">
            <!-- Screens only, companion parity. Scroll: fixed size can clip taller pages.
                 Horizontal scroll stays off so long lines wrap inside the
                 window width instead of growing it. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentScreen}"/>
            </ScrollViewer>
        </Border>
    </Border>
</Window>
