<Window x:Class="AceDrive.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AceDrive.Overlay.ViewModels"
        xmlns:views="clr-namespace:AceDrive.Overlay.Views"
        Title="AceDrive" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" ShowActivated="False"
        Background="Transparent" Topmost="True"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" MinWidth="200" MinHeight="80">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:BrandScreenViewModel}">
            <views:BrandScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GrandmaCarScreenViewModel}">
            <views:GrandmaCarScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VoiceInfoScreenViewModel}">
            <views:VoiceInfoScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DialogueScreenViewModel}">
            <views:DialogueScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MainControlScreenViewModel}">
            <views:MainControlScreenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeliveryJobScreenViewModel}">
            <views:DeliveryJobScreenView/>
        </DataTemplate>
    </Window.Resources>
    <!-- Two rings: the outer Border paints the background, its Padding pushes
         the edge line 10 px inward so the dark fill frames it. The window fill
         is transparent because an opaque window background would square off the
         rounded corners behind both rings.
         The dark fill is the fallback: the WebP backdrop is applied in code
         (MainWindow.ApplyBackdrop) because a XAML ImageSource would render-
         thread-crash on machines whose WIC has no WebP codec (older Win10). -->
    <Border x:Name="Backdrop" Background="#F214161A" CornerRadius="18" Padding="10">
        <Border BorderBrush="#FFFFFFFF" BorderThickness="2" CornerRadius="8" Padding="10">
            <!-- Screens only, companion parity. Scroll: fixed size can clip taller pages.
                 Horizontal scroll stays off so long lines wrap inside the
                 window width instead of growing it. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentScreen}"/>
            </ScrollViewer>
        </Border>
    </Border>
</Window>
