<UserControl x:Class="AceDrive.Overlay.Views.DeliveryJobScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization"
             xmlns:views="clr-namespace:AceDrive.Overlay.Views">
    <UserControl.Resources>
        <views:StockLevelToBrushConverter x:Key="StockFill"/>
    </UserControl.Resources>
    <!-- Same page skeleton as the other screens: viewport-pinned MinHeight,
         title band on top. Body order mirrors the Unity DeliveryJobScreen:
         stats header, store list, then the phase-flipping main button and
         the back/cancel button. The button bar lives in its own bottom band
         flush with the panel edge, the way the title is flush with the top
         one: the window chrome pads all sides equally, so zero own-margin
         mirrors the date's top spacing exactly. All copy arrives
         preformatted or from resx; the view draws and nothing else. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{loc:Loc Key=DeliveryTitle}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <TextBlock Text="{Binding CredPLine}" Foreground="#FFF" FontSize="12" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding CityGrowthLine}" Foreground="#FFF" FontSize="12" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding CitizensLine}" Foreground="#FFF" FontSize="12" Margin="0,0,0,8"/>
            <!-- Instruction line above the stock levels; same muted voice as the
                 hub subtitle. Meaningless without stores to tap, so it hides
                 exactly where DeliveryEmpty shows (inverse HasStores trigger). -->
            <TextBlock Text="{loc:Loc Key=DeliverySelectHint}" Foreground="#B0FFFFFF"
                       FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,14,0,14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStores}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- The number button IS the row's button: tapping ONE,
                             TWO, … confirms or drops the full-restock order for
                             that store (per-item steppers arrive with the order
                             screen). The store read-out keeps its place beside
                             it, borderless. -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding NumberWord}"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.ToggleOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding NameLine}" Foreground="#FFF" FontSize="13"
                                                   FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding OwnerLine}" Foreground="#B0FFFFFF" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding PercentLine}" Foreground="#FFF" FontSize="13"
                                                   FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{loc:Loc Key=DeliveryUrgent}" Foreground="#FFFFB300"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"
                                                   Visibility="{Binding IsUrgent, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding UnitsLine}" Foreground="#FFF" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GrowthLine}" Foreground="#B0FFFFFF" FontSize="12"/>
                                </Grid>
                                <ProgressBar Style="{StaticResource StockBar}" Value="{Binding Percent}"
                                             Foreground="{Binding Level, Converter={StaticResource StockFill}}"
                                             Margin="0,3,0,0"/>
                                <!-- Confirmed rows trade the stock read-out for the
                                     order summary (Unity BuildConfirmedRow). Empty
                                     string means unconfirmed: collapse the line. -->
                                <TextBlock Text="{Binding ConfirmedLine}" Foreground="#FF97EAD2" FontSize="12"
                                           Margin="0,3,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConfirmedLine}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{loc:Loc Key=DeliveryEmpty}" Foreground="#FFF" FontSize="13"
                       TextWrapping="Wrap" Margin="4,0,4,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStores}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- Fresh career nudge (no CredP, no hub yet): Max's first visit
                 banks the intro gift, so OPEN NEW CAREER has something to
                 spend. Lives beside the empty state, which shows for the same
                 gated career at boot. -->
            <TextBlock Text="{loc:Loc Key=DeliveryNeedCredP}" Foreground="#FF97EAD2"
                       FontSize="13" TextWrapping="Wrap" Margin="4,0,4,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowFirstCredPHint}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <!-- Button bar: own bottom band so the last button ends flush with
             the panel edge; the 6 px between them keeps the list rhythm.
             Teal is the shared voice-ack highlight: the button the mic
             tapped glows for one beat before the page waits it out. -->
        <StackPanel Grid.Row="2">
            <Button Content="{Binding MainButtonLabel}" Margin="0,0,0,6" Command="{Binding MainButtonCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MainFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{Binding BackButtonLabel}" Command="{Binding BackCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
