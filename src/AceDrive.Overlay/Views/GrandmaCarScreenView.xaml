<UserControl x:Class="AceDrive.Overlay.Views.GrandmaCarScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Same page skeleton as the other introduction pages: viewport-pinned
         MinHeight, title row at the top, the one action in its own bottom row.
         The car is a picture, not a picker: the offer is fixed, so the render
         sits centered in the height left over with the instruction line
         directly under it, and CONTINUE is the page's only button. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{loc:Loc Key=GrandmaCarTitle}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="{Binding Car.ImagePath, Converter={StaticResource ThumbnailImage}}"
                   MaxWidth="420" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10"
                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Style="{StaticResource PageBody}" Text="{loc:Loc Key=GrandmaCarInstruction}"
                       MaxWidth="420"/>
        </StackPanel>
        <!-- The *2* column keeps CONTINUE at half the text column's width, the
             same shape the dialogue and voice pages use for their bottom row. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{loc:Loc Key=DialogueContinue}" Padding="4"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ContinueCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <!-- Teal voice-ack glow: the spoken CONTINUE waits
                                 out the shared beat before the hand-over. -->
                            <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
