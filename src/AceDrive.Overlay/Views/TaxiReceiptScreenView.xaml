<UserControl x:Class="AceDrive.Overlay.Views.TaxiReceiptScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Receipt page skeleton like the other job pages: viewport-pinned
         MinHeight, title row, body centered below it, CONTINUE in the bottom
         row. The body mirrors the Unity TaxiReceiptScreen lines: distance,
         customer, per-tier fare breakdown, forfait, fare, tip and fine
         (zero rows collapse), totals, wallet and shift, XP with its
         calculation line. Type runs larger than the surrounding pages: the
         receipt is read at a glance while driving. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20" Text="{loc:Loc Key=ReceiptTitle}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding DistanceLine}" Foreground="#FFF" FontSize="18"
                       TextAlignment="Center" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding CustomerLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding FriendshipLine}" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasFriendship, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FriendshipHighlight}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding TierLines}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#FFBFC4C9" FontSize="14"
                                   TextAlignment="Center"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ForfaitLine}" Foreground="#FFF" FontSize="16"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding FareLine}" Foreground="#FFF" FontSize="16"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding TipLine}" Foreground="#FFF" FontSize="16"
                       TextAlignment="Center"
                       Visibility="{Binding HasTip, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding FineLine}" Foreground="#FFFF9D9D" FontSize="16"
                       TextAlignment="Center"
                       Visibility="{Binding HasFine, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding TotalLine}" Foreground="#FF97EAD2" FontSize="20"
                       TextAlignment="Center" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding WalletLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding ShiftLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding XpLine}" Foreground="#FFF" FontSize="16"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding XpCalcLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding TotalXpLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" Margin="0,0,0,4"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{loc:Loc Key=ReceiptContinue}" Padding="4"
                    HorizontalAlignment="Stretch" Command="{Binding ContinueCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
