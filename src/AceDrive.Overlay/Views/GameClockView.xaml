<UserControl x:Class="AceDrive.Overlay.Views.GameClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AceDrive.Overlay.Views"
             x:Name="Root"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Top">
    <UserControl.Resources>
        <!-- Tourney Thin, the clock face from ontwerpdesign.psd (OFL, shipped
             under Assets/Fonts). The pack URI addresses the embedded file's
             family; a machine without it falls back to the default face
             rather than failing the page. -->
        <FontFamily x:Key="TourneyThin">pack://application:,,,/AceDrive.Overlay;component/Assets/Fonts/#Tourney Thin</FontFamily>
    </UserControl.Resources>
    <!-- The design's clock header (ontwerpdesign.psd, top band y = 0..942):
         the game clock as a white outline in Tourney Thin, stretched to the
         PSD's 0.724 x 1.967 text transform, over the abbreviated weekday and
         display week. The menu and the calendar share this one view so both
         pages render the clock identically.
         The negative side margin reclaims MainWindow's 22 px chrome (10 px
         padding + 2 px edge + 10 px padding), so 1080 design px map to the
         whole 413.6 px panel like the backdrop; the Viewbox keeps the band on
         the design's proportions.
         The outline is drawn by OutlinedText because WPF has no text stroke;
         scaling the geometry then stroking keeps the 3 px edge even on the
         vertical and the horizontal strokes alike. -->
    <Viewbox Stretch="Uniform" VerticalAlignment="Top" Margin="-22,0,-22,0">
        <Grid Width="1080" Height="942">
            <views:OutlinedText Text="{Binding ClockText, ElementName=Root}"
                                FontFamily="{StaticResource TourneyThin}"
                                FontSize="333.333"
                                ScaleX="0.72432" ScaleY="1.96732"
                                Stroke="White" StrokeThickness="3"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,175,0,0"/>
            <!-- The PSD's subtitle face is Neue Haas Grotesk, which is not
                 redistributable: Segoe UI Light at the tuned 68.5 design px
                 matches its width and cap height. -->
            <TextBlock Text="{Binding DayWeekText, ElementName=Root}"
                       FontFamily="Segoe UI Light" FontSize="68.5"
                       Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,641,0,0"/>
        </Grid>
    </Viewbox>
</UserControl>
