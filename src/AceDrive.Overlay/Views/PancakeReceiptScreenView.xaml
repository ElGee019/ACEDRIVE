<UserControl x:Class="AceDrive.Overlay.Views.PancakeReceiptScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Pancake visit receipt (PORTPLAN 52): the plate that came off the meter,
         the stack packed for the road and where it lives, then CONTINUE. The
         flow served the meal and stamped the week before this page opened, so
         nothing here is interactive except the exit. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20"
                   Text="{Binding Title}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="16,0">
            <TextBlock Text="{Binding MealLine}" Foreground="#FF97EAD2" FontSize="20"
                       FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <TextBlock Text="{Binding PackedLine}" Foreground="#FFF" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{loc:Loc Key=ReceiptContinue}" Padding="4"
                    HorizontalAlignment="Stretch" Command="{Binding ContinueCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
