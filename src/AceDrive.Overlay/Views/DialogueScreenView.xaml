<UserControl x:Class="AceDrive.Overlay.Views.DialogueScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Same page skeleton as GrandmaCarScreenView: viewport-pinned MinHeight,
         title row above the centered body. The button sits in its own bottom
         row: the inner border's 10 px padding leaves exactly the same gap to
         the edge line as the title has at the top. The *2*/* column split below
         centres it at half the text column's width. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="21"
                   TextWrapping="Wrap" Text="{Binding Title}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding SpeakerName}" Foreground="#FFF" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,9,0,3"/>
            <!-- Dialogue text matches the HUD's task line (16 px), so both read
                 at the same size from the driver's seat. Spacing follows that
                 font: two blank lines between speaker and body (~42 px). -->
            <TextBlock Text="{Binding Body}" Foreground="#FFF" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,42,0,12"/>
            <!-- Authored aside under a rule: guidance that is not part of what
                 the speaker says (Max's first-visit pointer at the JOBS page).
                 The rule is the wallet page's section divider; teal is the
                 app's "do this next" colour, so it reads as a hint and not as
                 more dialogue. Hidden whole when the page carries no note. -->
            <StackPanel Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                <Border BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Note}" Foreground="#FF97EAD2" FontSize="13"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <!-- One-time guidance above CONTINUE, first page only: the voice
                 lesson after the consent page (the mic is live and this is the
                 button its example names). Collapsed on every later page. -->
            <TextBlock Text="{Binding FirstPageHint}" Foreground="#FF97EAD2" FontSize="13"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"
                       Visibility="{Binding HasFirstPageHint, Converter={StaticResource BoolToVis}}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="{loc:Loc Key=DialogueContinue}" Padding="4"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ContinueCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <!-- Teal voice-ack glow: every CONTINUE tap (a
                                     page turn or the finish) waits out the beat
                                     on this button before advancing. -->
                                <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                    <Setter Property="Foreground" Value="#FF97EAD2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
