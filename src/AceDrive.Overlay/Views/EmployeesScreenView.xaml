<UserControl x:Class="AceDrive.Overlay.Views.EmployeesScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <UserControl.Resources>
        <Style x:Key="EmployeeRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
        <Style x:Key="EmployeeName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <!-- The collected line is the payoff: it reads teal until the
                     three seconds run out and the name comes back. -->
                <DataTrigger Binding="{Binding IsEarning}" Value="True">
                    <Setter Property="Foreground" Value="#FF97EAD2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EmployeeNotOnJobButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- ARRIVED is the collect action, so it carries the page's teal
             accent even before the tap. -->
        <Style x:Key="EmployeeArrivedButton" TargetType="Button"
               BasedOn="{StaticResource EmployeeNotOnJobButton}">
            <Setter Property="Foreground" Value="#FF97EAD2"/>
        </Style>
        <Style x:Key="EmployeeOnJobText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF97EAD2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <!-- Employees page (PORTPLAN 23, the menu's EMPLOYEES tile): the hired crew
         only. Each row shows the name on the left and, on the right, NOT ON JOB
         (opens the assign page), ON JOB while the job runs, or ARRIVED once it
         is due; collecting ARRIVED pays the job and swaps the name for the
         earned line for three seconds. The player's car and every running job
         take one, so with none unused the page hides the NOT ON JOB buttons and
         says so above the crew.
         BACK is the bottom band's one button, like the bank's stack. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20"
                   Text="{loc:Loc Key=EmployeesTitle}"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="16,0">
            <TextBlock Style="{StaticResource FormLabel}"
                       Text="{loc:Loc Key=EmployeesTeam}"/>
            <TextBlock Text="{Binding NoUnusedCarsLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,8"
                       Visibility="{Binding ShowNoUnusedCars, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding EmptyLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,8"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Employees}"
                          Visibility="{Binding HasEmployees, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EmployeeRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource EmployeeName}"
                                           Text="{Binding DisplayName}"/>
                                <!-- NOT ON JOB opens the assign page; ARRIVED
                                     collects the finished job; ON JOB is plain
                                     text while the employee works. -->
                                <Button Grid.Column="1"
                                        Style="{StaticResource EmployeeNotOnJobButton}"
                                        Content="{loc:Loc Key=EmployeesNotOnJob}"
                                        Command="{Binding DataContext.NotOnJobCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Name}"
                                        Visibility="{Binding ShowNotOnJob, Converter={StaticResource BoolToVis}}"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource EmployeeArrivedButton}"
                                        Content="{loc:Loc Key=EmployeesArrived}"
                                        Command="{Binding DataContext.ArrivedCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Name}"
                                        Visibility="{Binding Arrived, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource EmployeeOnJobText}"
                                           Text="{loc:Loc Key=EmployeesOnJob}"
                                           Visibility="{Binding OnJob, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Button Content="{loc:Loc Key=EmployeesBack}" Command="{Binding BackCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
