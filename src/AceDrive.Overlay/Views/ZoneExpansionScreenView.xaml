<UserControl x:Class="AceDrive.Overlay.Views.ZoneExpansionScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization"
             xmlns:views="clr-namespace:AceDrive.Overlay.Views">
    <!-- Operating-zone expansion page (TOZONES §4.5, Unity ZoneExpansionScreen):
         the street that just joined, the zone's new count and area, the jobs to
         the next expansion, and the businesses this growth opened. Same page
         skeleton as the receipts: viewport-pinned MinHeight, title row, body
         centered, the two actions stacked in the bottom row. CONTINUE is the
         primary path; FIND STREET opens the addresses page (the map stand-in). -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20"
                   Text="{Binding Title}"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="16,0">
            <TextBlock Text="{loc:Loc Key=ZoneExpansionNewStreet}" Foreground="#FFBFC4C9"
                       FontSize="14" TextAlignment="Center"/>
            <TextBlock Text="{Binding StreetLine}" Foreground="#FF97EAD2" FontSize="26"
                       FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,2,0,10"/>
            <TextBlock Text="{Binding ZoneLine}" Foreground="#FFF" FontSize="16"
                       TextAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding PreviousAreaLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding NewAreaLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding JobsToNextLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" Margin="0,0,0,4"/>

            <!-- The doors this growth opened, one row per business. Hidden
                 entirely when the expansion opened none (the early thresholds
                 only name the street). -->
            <StackPanel Visibility="{Binding HasBusinesses, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource SectionDivider}"/>
                <TextBlock Text="{loc:Loc Key=ZoneExpansionNewBusinesses}" Foreground="#FFF"
                           FontSize="14" FontWeight="Bold" TextAlignment="Center"
                           Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding BusinessLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#FFBFC4C9" FontSize="14"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,0,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Longest-operating-zone world standings (Unity
                 ZoneStandingsService): label, rank line and the gained/lost
                 delta, hidden entirely when this build has no board behind it.
                 Same pulse and teal delta colour as the receipt's XP block. -->
            <StackPanel Visibility="{Binding Standings.IsVisible, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource SectionDivider}"/>
                <TextBlock Text="{loc:Loc Key=ZoneStandingsLabel}" Foreground="#FFF"
                           FontSize="14" FontWeight="Bold" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                <views:StandingsLine Text="{Binding Standings.Line}"
                                     PulseSignal="{Binding Standings.PulseSignal}"
                                     Foreground="#FFF" FontSize="16" TextAlignment="Center"/>
                <TextBlock Text="{Binding Standings.DeltaLine}" FontSize="14"
                           TextAlignment="Center" Margin="0,0,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Standings.Changed}" Value="True">
                                    <Setter Property="Foreground" Value="#FF97EAD2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Bottom band: CONTINUE above FIND STREET, both flush with the panel
             edge like every other page. Teal is the shared voice-ack glow. -->
        <StackPanel Grid.Row="2">
            <Button Content="{loc:Loc Key=ZoneExpansionContinue}" Command="{Binding ContinueCommand}"
                    Margin="0,0,0,6">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{loc:Loc Key=ZoneExpansionFindStreet}"
                    Command="{Binding FindStreetCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FindStreetFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
