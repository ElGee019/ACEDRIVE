<UserControl x:Class="AceDrive.Overlay.Views.CommunityCentreScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <UserControl.Resources>
        <!-- One candidate row: the resident over their familiarity, with the
             row's HIRE button on the right. The list is short (Unity's five),
             so the page scrolls as a whole instead of the rows scrolling. -->
        <Style x:Key="HireRowBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
        <Style x:Key="HireRowButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HireRowName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="HireRowFriendship" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFBFC4C9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>
    <!-- Community centre hiring page (PORTPLAN 54, Unity CommunityCentre's
         hire mode): title band, the greeting, HIRE AN EMPLOYEE, then the
         week's residents once the button is tapped. Unity hides the rows again
         after a hire, so the confirmation is the only thing under the button
         until the player asks for the next candidates. BACK is the bottom
         band's one button, like the bank's stack. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20"
                   Text="{loc:Loc Key=CommunityCentreTitle}"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="16,0">
            <TextBlock Text="{Binding Greeting}" Foreground="#FFF" FontSize="14"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,10"/>

            <!-- The one forward action the page always offers: it reveals the
                 roster, and after a hire it reveals the remaining candidates. -->
            <Button Content="{loc:Loc Key=CommunityCentreHire}"
                    Command="{Binding ShowCandidatesCommand}" Margin="0,0,0,8"/>

            <!-- Unity's _textHired: the confirmation that replaces the rows
                 once a resident joins the crew. -->
            <TextBlock Text="{Binding HiredLine}" Foreground="#FF97EAD2" FontSize="14"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,8"
                       Visibility="{Binding ShowHired, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Text="{loc:Loc Key=CommunityCentreEmpty}" Foreground="#FFBFC4C9"
                       FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,2,0,8"
                       Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>

            <StackPanel Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource FormLabel}"
                           Text="{loc:Loc Key=CommunityCentreCandidates}"/>
                <ItemsControl ItemsSource="{Binding Candidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HireRowBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource HireRowName}"
                                                   Text="{Binding Name}"/>
                                        <TextBlock Style="{StaticResource HireRowFriendship}"
                                                   Text="{Binding FriendshipLine}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource HireRowButton}"
                                            Content="{loc:Loc Key=CommunityCentreHireRow}"
                                            Command="{Binding DataContext.HireCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Button Content="{loc:Loc Key=CommunityCentreBack}" Command="{Binding BackCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
