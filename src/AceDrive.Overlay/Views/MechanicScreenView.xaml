<UserControl x:Class="AceDrive.Overlay.Views.MechanicScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <UserControl.Resources>
        <!-- Queued part row: teal edge, the dealer/hub activation tell. -->
        <Style x:Key="MechanicRowBorder" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Queued}" Value="True">
                    <Setter Property="BorderBrush" Value="#FF97EAD2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Everything below the car line collapses on an empty garage. -->
        <Style x:Key="WhenCar" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasCar}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Car mechanic page (PORTPLAN items 31/32, Unity CarMechanicScreen):
         breakdown chance + engine condition, the stranded-engine block when it
         is broken, the part rows (efficiency, price, ADD) and the queued total,
         then REPAIR PARTS / REPAIR ENGINE / BUY NEW ENGINE above BACK. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20" Text="{loc:Loc Key=MechanicTitle}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding CarLine}" Foreground="#FFF" FontSize="14" FontWeight="Bold"
                           TextAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CashLine}" Foreground="#FFF" FontSize="12"
                           TextAlignment="Center" Style="{StaticResource WhenCar}"/>
                <TextBlock Text="{Binding BreakdownLine}" Foreground="#FFBFC4C9" FontSize="12"
                           TextAlignment="Center" Style="{StaticResource WhenCar}"/>
                <TextBlock Text="{Binding EngineConditionLine}" Foreground="#FFBFC4C9" FontSize="12"
                           TextAlignment="Center" Style="{StaticResource WhenCar}"/>
                <!-- Stranded engine: the failure note and the two economics lines
                     (Unity's _textEngineFailure block). -->
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding EngineFailureVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc Key=MechanicEngineFailure}" Foreground="#FFFF7A7A" FontSize="13"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="{Binding RepairEngineCostLine}" Foreground="#FFBFC4C9" FontSize="12"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding NewEngineCostLine}" Foreground="#FFBFC4C9" FontSize="12"
                               TextAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0" Style="{StaticResource WhenCar}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,1" Padding="2" BorderThickness="1" BorderBrush="Transparent"
                                    Style="{StaticResource MechanicRowBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#FFF" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#FFF" FontSize="12"
                                               Margin="6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PriceText}" Foreground="#FFBFC4C9" FontSize="12"
                                               Margin="6,0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Content="{Binding ActionLabel}" FontSize="11" Padding="6,1"
                                            IsEnabled="{Binding AddEnabled}"
                                            Visibility="{Binding AddVisible, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding TotalLine}" Foreground="#FFF" FontSize="13" FontWeight="Bold"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding TotalVisible, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2">
            <Button Content="{loc:Loc Key=MechanicRepairParts}" Command="{Binding RepairPartsCommand}"
                    Margin="0,0,0,6"
                    Visibility="{Binding RepairPartsVisible, Converter={StaticResource BoolToVis}}"/>
            <Button Content="{loc:Loc Key=MechanicRepairEngine}" Command="{Binding RepairEngineCommand}"
                    Margin="0,0,0,6"
                    Visibility="{Binding EngineButtonsVisible, Converter={StaticResource BoolToVis}}"/>
            <Button Content="{loc:Loc Key=MechanicNewEngine}" Command="{Binding NewEngineCommand}"
                    Margin="0,0,0,6"
                    Visibility="{Binding EngineButtonsVisible, Converter={StaticResource BoolToVis}}"/>
            <Button Content="{loc:Loc Key=DeliveryBack}" Command="{Binding BackCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
