<UserControl x:Class="AceDrive.Overlay.Views.VoiceConsentScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Same page skeleton as VoiceInfoScreenView: viewport-pinned MinHeight,
         title row at a fixed height, body centered below it, the action row at
         the bottom. The body is the permission ask; the two buttons are the
         only way off the page. The voice lesson lives on the first birthday
         page, where the mic is already on. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{loc:Loc Key=VoiceInfoTitle}"/>
        <TextBlock Grid.Row="1" Style="{StaticResource PageBody}" Text="{loc:Loc Key=VoiceConsentIntro}"
                   VerticalAlignment="Center"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,4,0,6">
            <Button Content="{loc:Loc Key=VoiceConsentConfirm}" Command="{Binding ConfirmCommand}"
                    Padding="12,4" Margin="0,0,10,0"/>
            <Button Content="{loc:Loc Key=VoiceConsentDecline}" Command="{Binding DeclineCommand}"
                    Padding="12,4"/>
        </StackPanel>
    </Grid>
</UserControl>
