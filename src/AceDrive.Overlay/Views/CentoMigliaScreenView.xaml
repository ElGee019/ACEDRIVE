<UserControl x:Class="AceDrive.Overlay.Views.CentoMigliaScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Cento Miglia page (PORTPLAN 49, Unity CentoMigliaScreen): the same page
         skeleton as the other pages - viewport-pinned MinHeight, title band,
         one body block centered in the leftover height, BACK flush at the
         bottom. Three panels share the body slot like Unity's CentoA/CentoB:
         the tier list, the picked tier's description and eligibility, then the
         ENTER flow's build (registration number, countdown, built route).
         A locked tier stays on the page and only loses its ink, exactly like
         Unity's non-interactable button. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{loc:Loc Key=CentoTitle}"/>
        <TextBlock Grid.Row="1" Style="{StaticResource PageBody}" Text="{Binding WeekLine}"/>
        <TextBlock Grid.Row="2" Style="{StaticResource PageBody}" Text="{Binding ReputationLine}"/>
        <Grid Grid.Row="3">
            <!-- CentoA: the clubs, each with the reputation level it asks for.
                 The list starts under the header and runs the panel's width,
                 like Unity's 500-of-1200 button column scaled to this panel. -->
            <StackPanel VerticalAlignment="Top"
                        Visibility="{Binding IsTierList, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Tiers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,2" Padding="14,3" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding Eligible}"
                                    Command="{Binding DataContext.TierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="13" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Eligible}" Value="False">
                                                        <Setter Property="Foreground" Value="#66FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Requirement}" FontSize="11" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFBFC4C9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Eligible}" Value="False">
                                                        <Setter Property="Foreground" Value="#55FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <!-- CentoB: the picked club - its description and why the driver
                 does or does not qualify (Unity's registration line stays out
                 until ENTER builds the event). ENTER sits in the bottom band
                 with BACK, like every other page's primary action. -->
            <StackPanel VerticalAlignment="Center"
                        Visibility="{Binding IsDetail, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DetailLabel}" Foreground="#FFF" FontSize="14" FontWeight="Bold"
                           TextAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource PageBody}" Text="{Binding DetailDescription}"/>
                <TextBlock Style="{StaticResource PageBody}" Text="{Binding EligibilityText}" Margin="0,6,0,0"/>
            </StackPanel>
            <!-- CentoSetup: the ENTER flow (Unity's coroutine). The status
                 lines stay in a block at the top of the body; the registration
                 number is the event's identity, so it takes the big type and
                 sits in the middle of the gap between that block and the bottom
                 band's button. No way out while it runs; BACK returns past it. -->
            <Grid Visibility="{Binding SetupVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding SetupTitle}" Foreground="#FFF" FontSize="14" FontWeight="Bold"
                               TextAlignment="Center" Margin="0,0,0,2"/>
                    <TextBlock Style="{StaticResource PageBody}" Text="{Binding DetailLabel}"/>
                    <TextBlock Style="{StaticResource PageBody}" Text="{Binding TimerLine}"
                               Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Style="{StaticResource PageBody}" Text="{Binding DistanceLine}"
                               Visibility="{Binding IsBuilt, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <!-- Double the body size (PageBody is 14), no margin so the
                     vertical centering inside the leftover row stays exact. -->
                <TextBlock Grid.Row="1" Style="{StaticResource PageBody}" Text="{Binding RegistrationLine}"
                           FontSize="28" Margin="0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <!-- Bottom band: the picked tier's action above the one way out, both
             flush with the panel edge like every other page. ENTER turns into
             its own status line ("SETTING UP…", disabled) while the event is
             built, and BACK stays hidden until that build is done. -->
        <StackPanel Grid.Row="4">
            <Button Content="{Binding EnterLabel}" Command="{Binding EnterCommand}"
                    IsEnabled="{Binding CanEnter}" Margin="0,0,0,6"
                    Visibility="{Binding ShowEnter, Converter={StaticResource BoolToVis}}"/>
            <Button Content="{loc:Loc Key=DeliveryBack}" Command="{Binding BackCommand}"
                    Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
