<UserControl x:Class="AceDrive.Overlay.Views.DeliveryReceiptScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization"
             xmlns:views="clr-namespace:AceDrive.Overlay.Views">
    <!-- Delivery receipt page skeleton like the taxi receipt: viewport-pinned
         MinHeight, title row, body centered below it, CONTINUE in the bottom
         row. The body mirrors the Unity DeliveryReceiptScreen lines: total
         distance, hub-owner familiarity, goods money (paid out, paid back
         in), the tiered distance fare, total earned, wallet, Credibility
         Points earned and total, XP with its calculation line and the XP
         world standings pair. Zero rows collapse (CredP, familiarity);
         the earnings block stays centered like the taxi page shares its
         ReceiptLineTemplate. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20" Text="{loc:Loc Key=DelReceiptTitle}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Grid.IsSharedSizeScope="True">
            <TextBlock Text="{Binding DistanceLine}" Foreground="#FFF" FontSize="18"
                       TextAlignment="Center" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding FriendshipLine}" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasFriendship, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FriendshipHighlight}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ContentPresenter Content="{Binding PaidLine}"
                              ContentTemplate="{StaticResource ReceiptLineTemplate}"
                              TextElement.Foreground="#FFF" TextElement.FontSize="16"/>
            <ContentPresenter Content="{Binding ReceivedLine}"
                              ContentTemplate="{StaticResource ReceiptLineTemplate}"
                              TextElement.Foreground="#FFF" TextElement.FontSize="16"/>
            <ItemsControl ItemsSource="{Binding TierLines}" Foreground="#FFBFC4C9" FontSize="14"
                          ItemTemplate="{StaticResource ReceiptLineTemplate}" Margin="0,8,0,4"/>
            <ContentPresenter Content="{Binding FareLine}"
                              ContentTemplate="{StaticResource ReceiptLineTemplate}"
                              TextElement.Foreground="#FFF" TextElement.FontSize="16"/>
            <ContentPresenter Content="{Binding TotalLine}"
                              ContentTemplate="{StaticResource ReceiptLineTemplate}"
                              TextElement.Foreground="#FF97EAD2" TextElement.FontSize="20"
                              Margin="0,6,0,2"/>
            <TextBlock Text="{Binding WalletLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center"/>
            <!-- CredP block: earned + career total, hidden when the run
                 rested on no owned hub (no category, no career open yet). -->
            <StackPanel Visibility="{Binding HasCredP, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding CredPEarnedLine}" Foreground="#FFF" FontSize="16"
                           TextAlignment="Center"/>
                <TextBlock Text="{Binding TotalCredPLine}" Foreground="#FFBFC4C9" FontSize="14"
                           TextAlignment="Center"/>
            </StackPanel>
            <!-- The wallet's hairline above the XP award, matching the taxi
                 receipt's section rhythm. -->
            <Border Style="{StaticResource SectionDivider}"/>
            <TextBlock Text="{Binding XpLine}" Foreground="#FFF" FontSize="16"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding XpCalcLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding TotalXpLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" Margin="0,0,0,4"/>
            <!-- Global XP rank: same fenced block the taxi receipt hosts;
                 StandingsLine owns the pulse and restarts it on every rank
                 move, delta line gains AND lost render teal (Unity keeps
                 both green #97EAD2 verbatim). -->
            <Border Style="{StaticResource SectionDivider}" Margin="0,4,0,6"/>
            <views:StandingsLine Text="{Binding Standings.Line}"
                                 PulseSignal="{Binding Standings.PulseSignal}"
                                 Foreground="#FFF" FontSize="16" TextAlignment="Center"/>
            <TextBlock Text="{Binding Standings.DeltaLine}" FontSize="14"
                       TextAlignment="Center" Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Standings.Changed}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Style="{StaticResource SectionDivider}" Margin="0,0,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{loc:Loc Key=ReceiptContinue}" Padding="4"
                    HorizontalAlignment="Stretch" Command="{Binding ContinueCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
