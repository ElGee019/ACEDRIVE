<UserControl x:Class="AceDrive.Overlay.Views.CustomerRequestScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Customer request page (PORTPLAN 11, Unity CustomerRequestScreen):
         the ask, the answer countdown (19 s), three numbered quiz values
         (ONE/TWO/THREE, the delivery page's store rows) or ACCEPT/DECLINE,
         then feedback. A quiz result has no BACK: it reads for five seconds
         and returns to the task text by itself. A forced speed challenge
         reuses the page as a short read-in: its delivery clock instead of
         the answer countdown, no buttons, then it dismisses itself. The host
         ticks the clocks. -->
    <UserControl.Resources>
        <FontFamily x:Key="TourneyThin">pack://application:,,,/AceDrive.Overlay;component/Assets/Fonts/#Tourney Thin</FontFamily>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{loc:Loc Key=RequestTitle}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding RequestText}" Foreground="#FFF" FontSize="14"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,10"
                       Visibility="{Binding RequestTextVisible, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding TimeLine}"
                       TextAlignment="Center" Margin="0,0,0,10"
                       Foreground="#FFBFC4C9" FontSize="12"
                       Visibility="{Binding TimerVisible, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding DeliveryLine}"
                       TextAlignment="Center" Margin="0,0,0,10"
                       Visibility="{Binding DeliveryVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource TourneyThin}"/>
                        <Setter Property="FontSize" Value="30"/>
                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SpeedChallengeLate}" Value="True">
                                <Setter Property="Foreground" Value="#FFFF9E64"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- The number button names the slot and the value
                             reads beside it, exactly like the delivery page's
                             store rows. ACCEPT / DECLINE have no separate
                             read-out, so their button spans the row. -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding ButtonText}"
                                    Command="{Binding Command}" MinWidth="72"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasReadout}" Value="False">
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding Text}"
                                       Foreground="#FFF" FontSize="13" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding HasReadout, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Feedback}" FontSize="13" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,8,0,0"
                       Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FeedbackPositive}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{loc:Loc Key=DeliveryBack}" Padding="4"
                    HorizontalAlignment="Stretch" Command="{Binding BackCommand}"
                    Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
