<UserControl x:Class="AceDrive.Overlay.Views.StoreScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <UserControl.Resources>
        <!-- Shop rows are plain list lines, unlike the outlined action
             buttons: a transparent button template so the whole row is
             clickable and the three columns share one width. -->
        <Style x:Key="StoreRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="#FF97EAD2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Same page skeleton as the other companion pages: title band, the
         store body, then BUY/BACK in the bottom band. The root is
         transparent so the MainWindow backdrop stays the one background. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20"
                   Text="{Binding StoreTitle}"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding Greeting}" Foreground="#FFF" FontSize="14"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,3"/>
            <TextBlock Text="{Binding CashLine}" Foreground="#FFBFC4C9" FontSize="13"
                       TextAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="{loc:Loc Key=StoreAvailable}" Foreground="#FFF"
                       FontSize="13" FontWeight="Bold" Margin="0,4,0,2"/>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource StoreRow}"
                                Command="{Binding SelectCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           FontSize="12" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- Unity paints a sold-out
                                                     name teal while keeping
                                                     the hunger/price copy. -->
                                                <DataTrigger Binding="{Binding IsSoldOut}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF97EAD2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding HungerLine}"
                                           FontSize="12" Margin="6,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding PriceLine}"
                                           FontSize="12"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- GrocerySelection panel: item, amount, volume, price and the
                 projected trunk line all describe the same quote. -->
            <Border Background="#11FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="4" Padding="6" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding SelectionText}" Foreground="#FFF"
                               FontSize="13" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,4">
                        <Button Content="{loc:Loc Key=StoreDecrease}"
                                Command="{Binding DecreaseCommand}" Width="30"/>
                        <TextBlock Text="{Binding QuantityText}" Foreground="#FFF"
                                   FontSize="14" Width="34" TextAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Button Content="{loc:Loc Key=StoreIncrease}"
                                Command="{Binding IncreaseCommand}" Width="30"/>
                    </StackPanel>
                    <TextBlock Text="{Binding VolumeText}" FontSize="12"
                               TextAlignment="Center" Margin="0,1">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VolumeWarn}" Value="True">
                                        <Setter Property="Foreground" Value="#FF97EAD2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding PriceText}" FontSize="12"
                               TextAlignment="Center" Margin="0,1">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PriceWarn}" Value="True">
                                        <Setter Property="Foreground" Value="#FF97EAD2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding TrunkText}" FontSize="12"
                               TextAlignment="Center" Margin="0,1">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TrunkOverflow}" Value="True">
                                        <Setter Property="Foreground" Value="#FF97EAD2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding FriendshipText}" Foreground="#FF97EAD2"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,6,0,0"
                       Visibility="{Binding FriendshipVisible, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding BoughtText}" Foreground="#FF97EAD2"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,4,0,0"
                       Visibility="{Binding BoughtVisible, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Button Content="{loc:Loc Key=StoreBuy}" Command="{Binding BuyCommand}"
                    Margin="0,6,0,6"/>
            <Button Content="{loc:Loc Key=StoreBack}" Command="{Binding BackCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
