<UserControl x:Class="AceDrive.Overlay.Views.CarHaulReceiptScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Car-haul receipt page skeleton like the taxi and delivery receipts:
         viewport-pinned MinHeight, title row, body centered below it,
         CONTINUE in the bottom row. The body mirrors the Unity
         CarHaulingScreen lines: hauled car, dealer-owner familiarity
         (hidden while no dealer POI backs the job), drive duration,
         earning + wallet, driver rating, class tier and the resulting
         per-minute rate. No XP or XP world standings block: Unity settles
         the haul's cash alone. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20" Text="{loc:Loc Key=HaulReceiptTitle}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Grid.IsSharedSizeScope="True">
            <TextBlock Text="{Binding CarLine}" Foreground="#FFF" FontSize="18"
                       TextAlignment="Center" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding FriendshipLine}" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasFriendship, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FriendshipHighlight}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding TimeLine}" Foreground="#FFF" FontSize="16"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ContentPresenter Content="{Binding EarnedLine}"
                              ContentTemplate="{StaticResource ReceiptLineTemplate}"
                              TextElement.Foreground="#FF97EAD2" TextElement.FontSize="20"
                              Margin="0,6,0,2"/>
            <TextBlock Text="{Binding WalletLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding DriverRatingLine}" Foreground="#FFF" FontSize="16"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding TierLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding RateLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" Margin="0,0,0,4"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{loc:Loc Key=ReceiptContinue}" Padding="4"
                    HorizontalAlignment="Stretch" Command="{Binding ContinueCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
