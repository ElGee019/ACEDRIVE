<UserControl x:Class="AceDrive.Overlay.Views.ValuationScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <UserControl.Resources>
        <!-- Same label/value line as the garage page: the label column is fixed
             so every value starts on the same edge, whatever the translation
             runs to. -->
        <Style x:Key="StatsRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="StatsValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <!-- Weekly market-valuation page (PORTPLAN 49, Unity ValuationScreen). Two
         phases share the skeleton: the entry phase (the garage's car picker and
         the six preview values, ENTER WITH {car}) and the comparison phase (the
         player's side, the drawn opponent, the jury verdict and CONTINUE). The
         page only paints what the flow hands it: it computes no score and never
         talks to the board or the wallet. Same page skeleton as the garage and
         receipt pages: title band, centred body, buttons at the bottom. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20"
                   Text="{Binding Title}"/>
        <TextBlock Grid.Row="1" Text="{Binding VenueLine}" Foreground="#FF97EAD2"
                   FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,0,0,6"/>
        <!-- Entry phase -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="16,0"
                    Visibility="{Binding IsEntry, Converter={StaticResource BoolToVis}}">
            <!-- White at the picker's own size: the instruction reads as part of
                 the page's body, not as a dim caption above the card. -->
            <TextBlock Text="{Binding IntroLine}" Foreground="#FFF" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <!-- The shared hairline closes the instruction off from the card
                 below it, so the terms of the score read as a preamble instead
                 of as the picker's caption. -->
            <Border Style="{StaticResource SectionDivider}" Margin="0,0,0,12"/>
            <!-- The empty-garage hint keeps the page honest instead of showing
                 a picker with nothing in it. -->
            <TextBlock Text="{Binding EmptyLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCars}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Visibility="{Binding HasCars, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource FormLabel}" Text="{Binding SelectLabel}"/>
                <ComboBox Style="{StaticResource FormCombo}"
                          ItemsSource="{Binding Cars}"
                          SelectedItem="{Binding SelectedCar, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" Foreground="#FFF"/>
                                <TextBlock Text="{loc:Loc Key=GarageCurrent}" Margin="8,0,0,0"
                                           FontSize="11" Foreground="#FF97EAD2"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ItemsControl ItemsSource="{Binding Stats}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Style="{StaticResource StatsRow}">
                                <Grid.ColumnDefinitions>
                                    <!-- Wider than the garage's column: the
                                         page's longest caption is LEADERBOARD
                                         RANKING, which measures ~140 px in the
                                         bold label face before its 8 px gap. -->
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource FormLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                           Style="{StaticResource StatsValue}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
        <!-- Comparison phase -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="16,0"
                    Visibility="{Binding IsComparison, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding OwnName}" Foreground="#FFF" FontSize="16"
                       FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="{Binding OwnCarName}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding OwnScoreText}" Foreground="#FF97EAD2" FontSize="14"
                       TextAlignment="Center" Margin="0,2,0,10"/>
            <TextBlock Text="{Binding WaitingText}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center"
                       Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Visibility="{Binding HasCompetitor, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding OpponentName}" Foreground="#FFF" FontSize="16"
                           FontWeight="Bold" TextAlignment="Center"/>
                <TextBlock Text="{Binding OpponentCarName}" Foreground="#FFBFC4C9" FontSize="14"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding OpponentScoreText}" Foreground="#FF97EAD2" FontSize="14"
                           TextAlignment="Center" Margin="0,2,0,10"/>
                <TextBlock Text="{Binding ResultText}" Foreground="#FFF" FontSize="20"
                           FontWeight="Bold" TextAlignment="Center"/>
                <TextBlock Text="{Binding JuryText}" Foreground="#FFBFC4C9" FontSize="13"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,6"/>
                <TextBlock Text="{Binding EarningsText}" Foreground="#FF97EAD2" FontSize="14"
                           TextAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <!-- Bottom band: the page's verb above the one way out, both flush
             with the panel edge like every other page (Cento precedent). ENTER
             rides above BACK while the picker is up; once the comparison
             starts, CONTINUE takes the bottom slot BACK held, so the page's
             surviving verb never jumps. Teal is the shared voice-ack
             highlight, one flash per button. -->
        <StackPanel Grid.Row="3">
            <Button Content="{Binding EnterLabel}" Command="{Binding EnterCommand}"
                    Padding="4" Margin="0,0,0,6"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding IsEntry, Converter={StaticResource BoolToVis}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EnterFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- The bottom slot holds exactly one button per phase: BACK while
                 the picker is up, CONTINUE once the verdict landed. -->
            <Grid>
                <Button Content="{loc:Loc Key=ValuationBack}" Command="{Binding BackCommand}"
                        Padding="4" HorizontalAlignment="Stretch"
                        Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BackFlash}" Value="True">
                                    <Setter Property="Foreground" Value="#FF97EAD2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}"
                        Padding="4" HorizontalAlignment="Stretch"
                        Visibility="{Binding HasCompetitor, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                    <Setter Property="Foreground" Value="#FF97EAD2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
