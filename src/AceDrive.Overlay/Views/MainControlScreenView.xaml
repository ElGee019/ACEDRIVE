<UserControl x:Class="AceDrive.Overlay.Views.MainControlScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Same page skeleton as DialogueScreenView: viewport-pinned MinHeight,
         title band on top, BACK in the bottom band. The body is two bands: the
         job buttons (Unity JobSelectionScreen order: taxi, then delivery, then
         the car-hauling placeholder) centered in the upper band, Grandma's ToDo
         centered in the lower. The weekly calendar strip lives on its own page
         now, reached from the menu's CALENDAR tile. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{loc:Loc Key=ControlJobs}"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Job buttons: centered in the band above Grandma's ToDo.
                 The hunger and filth readings live on the menu's battery
                 tiles (PORTPLAN items 26/33), so the job entries lead here. -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <Button Content="{Binding TaxiLabel}" Margin="0,0,0,6"
                        Command="{Binding TaxiCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TaxiFlash}" Value="True">
                                    <Setter Property="Foreground" Value="#FF97EAD2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding DeliveryLabel}"
                        Command="{Binding DeliveryCommand}" Margin="0,0,0,6">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DeliveryFlash}" Value="True">
                                    <Setter Property="Foreground" Value="#FF97EAD2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding HaulLabel}"
                        Command="{Binding HaulCommand}" Margin="0,0,0,6">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HaulFlash}" Value="True">
                                    <Setter Property="Foreground" Value="#FF97EAD2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <!-- Grandma's ToDo: centered in the band below the job buttons. -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Key=ControlTodo}" Foreground="#FFF" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding TodoLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="#FFF" FontSize="13" TextWrapping="Wrap" Margin="0,1"
                                       Text="{Binding Mode=OneWay}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
        <!-- Bottom band: the one way back to the menu, flush with the panel
             edge like every page's back button. Teal is the shared voice-ack
             highlight: the BACK the mic tapped glows for one beat before the
             page waits it out. -->
        <Button Grid.Row="2" Content="{loc:Loc Key=DeliveryBack}" Command="{Binding BackCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BackFlash}" Value="True">
                            <Setter Property="Foreground" Value="#FF97EAD2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
