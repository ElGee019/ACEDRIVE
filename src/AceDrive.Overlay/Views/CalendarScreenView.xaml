<UserControl x:Class="AceDrive.Overlay.Views.CalendarScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AceDrive.Overlay.Views"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <UserControl.Resources>
        <!-- Inter Thin 100 is the face the menu tiles label their buttons in
             (SIL OFL, shipped under Assets/Fonts). The day names repeat that
             face and its drawn size, so the strip's left column reads as part
             of the same design: the artwork's "JOBS" ink is 34 px tall, the
             tile Viewbox paints the tile art at 310/307 of its pixels and the
             1080-wide design canvas at 413.6/1080 of the panel, so the label
             lands at ~13.1 px on screen; Inter's cap height is 0.727 em, which
             makes 18 px the same size. A machine without the embedded face
             falls back to the default. -->
        <FontFamily x:Key="TileFace">pack://application:,,,/AceDrive.Overlay;component/Assets/Fonts/#Inter Thin</FontFamily>
    </UserControl.Resources>
    <!-- Calendar page skeleton: viewport-pinned MinHeight like the menu page.
         The top band repeats the menu's 942* row and shared clock view, so the
         calendar's clock renders at exactly the same height; the lower 1338*
         band carries the CALENDAR title, the Monday-first strip and BACK. Only
         days with an event render the event as a Button (global white-edge
         style). Day names wear the menu tiles' own face and size (TileFace
         above); the event labels stay body copy in the platform UI face at the
         small size, so a long event never outshouts the day it belongs to. The
         highlighted (current game) day wears teal on both halves:
         the event button takes the teal outline in place of the old teal text,
         and the day name joins it — eventless days still mark today by name.
         Tapping a row inside its gate glows the button text teal for one beat
         like every other button; outside it the text swaps to the white COME
         BACK warning for three seconds. The road-test button names the week's
         car inside its outline. Empty events collapse the button so eventless
         days show just their name. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="942*"/>
            <RowDefinition Height="1338*"/>
        </Grid.RowDefinitions>
        <!-- Same clock view and band as the menu: identical face, outline,
             scale, weekday/week line and height. -->
        <views:GameClockView Grid.Row="0"
                             ClockText="{Binding ClockText}"
                             DayWeekText="{Binding DayWeekText}"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{loc:Loc Key=ControlCalendar}"/>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Calendar strip: the page's one body block, centered. -->
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Days}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- SharedSizeGroup keeps every day row the same height:
                                     button rows measure taller (border + padding), so
                                     plain-text rows would otherwise sit tighter. The
                                     day label centers itself on the shared height, which
                                     lines its baseline up with the button content.
                                     Teal is the shared highlight (hub activated
                                     cells): the selectable day wears it on the
                                     button border and the day name alike. -->
                                <Grid Margin="0,1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" SharedSizeGroup="DayRow"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <!-- Wide enough for "Wednesday"/"Donderdag" at
                                             the tile face's 18 px; the old 90 only
                                             fitted the 13 px body size. -->
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DayLabel}"
                                               FontFamily="{StaticResource TileFace}" FontSize="18"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFF"/>
                                                <Style.Triggers>
                                                    <!-- The name wears the shared teal whenever the
                                                         button beside it wears the outline, so even
                                                         an eventless today still marks the day. -->
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF97EAD2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="1" Margin="0,1"
                                            Command="{Binding DataContext.DayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding DayOfWeek}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EventLabel}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <!-- The selectable day's button wears the teal
                                                         outline; its event text stays white until a
                                                         tap glows it. -->
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF97EAD2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <!-- Event copy keeps the compact platform
                                             face at the old size: the button is
                                             the secondary read, the day is the
                                             anchor. -->
                                        <TextBlock Text="{Binding EventLabel}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Flash}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF97EAD2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
            <!-- Bottom band: the one way out, flush with the panel edge like every
                 page's back button. Teal is the shared voice-ack highlight: the
                 BACK the mic tapped glows for one beat before the page waits it out. -->
            <Button Grid.Row="2" Content="{loc:Loc Key=DeliveryBack}" Command="{Binding BackCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
