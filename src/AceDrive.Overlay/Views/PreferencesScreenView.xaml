<UserControl x:Class="AceDrive.Overlay.Views.PreferencesScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- First page of the introduction, reused by the menu's Settings tile
         until a fuller settings screen lands. Copy is bound to the ViewModel
         instead of {loc:Loc}: this page IS the language selector, so its own
         labels must re-read the moment the player picks another language. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabel}"
                           Text="{Binding UnitsLabel}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormCombo}"
                          ItemsSource="{Binding UnitOptions}"
                          SelectedItem="{Binding SelectedUnit}"
                          Margin="0,0,0,6">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="#FFF"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}"
                           Text="{Binding LanguageLabel}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormCombo}"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="#FFF"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- Settings entry only: a first run has no session to leave, so
                 QUIT stays collapsed there. It runs the window's own close
                 path (wired in App), which banks the session on the way out. -->
            <Button Content="{Binding QuitLabel}"
                    Command="{Binding QuitCommand}"
                    Margin="0,28,0,0"
                    Visibility="{Binding CanQuit, Converter={StaticResource BoolToVis}}"/>

            <!-- Settings entry only: a first run has no career to wipe, so the
                 whole block stays collapsed there. The warning appears between
                 the two taps of the reset button. -->
            <StackPanel Margin="0,28,0,0"
                        Visibility="{Binding CanReset, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ResetWarning}"
                           Foreground="#FFFF7A7A" FontSize="12"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding IsConfirmingReset, Converter={StaticResource BoolToVis}}"/>
                <Button Content="{Binding ResetLabel}"
                        Command="{Binding ResetCommand}"
                        Foreground="#FFFF7A7A" BorderBrush="#FFFF7A7A"
                        Margin="0,8,0,0"/>
                <TextBlock Text="{Binding ResetStatus}"
                           Foreground="#FFFF7A7A" FontSize="12"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </StackPanel>
        <Button Grid.Row="2" Content="{Binding ContinueLabel}"
                Command="{Binding ContinueCommand}"/>
    </Grid>
</UserControl>
