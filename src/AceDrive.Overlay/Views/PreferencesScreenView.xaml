<UserControl x:Class="AceDrive.Overlay.Views.PreferencesScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- First page of the introduction, reused by the menu's Settings tile
         until a fuller settings screen lands. Copy is bound to the ViewModel
         instead of {loc:Loc}: this page IS the language selector, so its own
         labels must re-read the moment the player picks another language. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabel}"
                           Text="{Binding UnitsLabel}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FormCombo}"
                          ItemsSource="{Binding UnitOptions}"
                          SelectedItem="{Binding SelectedUnit}"
                          Margin="0,0,0,6">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="#FFF"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}"
                           Text="{Binding LanguageLabel}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormCombo}"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="#FFF"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </StackPanel>
        <Button Grid.Row="2" Content="{Binding ContinueLabel}"
                Command="{Binding ContinueCommand}"/>
    </Grid>
</UserControl>
