<UserControl x:Class="AceDrive.Overlay.Views.CarePackageReceiptScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Care-package receipt (PORTPLAN item 21): the kits the community centre
         took, the stores they came from and what is left for a later run. The
         flow delivered and banked before this page opened, so nothing here is
         interactive except CONTINUE. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20"
                   Text="{Binding Title}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding DeliveredLine}" Foreground="#FF97EAD2" FontSize="18"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding StoresLine}" Foreground="#FFBFC4C9" FontSize="13"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding HasStores, Converter={StaticResource BoolToVis}}"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <TextBlock Text="{Binding RemainingLine}" Foreground="#FFF" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{loc:Loc Key=ReceiptContinue}" Padding="4"
                    HorizontalAlignment="Stretch" Command="{Binding ContinueCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
