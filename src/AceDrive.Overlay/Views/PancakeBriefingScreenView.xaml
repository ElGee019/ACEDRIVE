<UserControl x:Class="AceDrive.Overlay.Views.PancakeBriefingScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Pancake Friday briefing (PORTPLAN 52): title band, the house named first
         so the drive is known, the visit's terms centered, then the reading it
         will move, and START DRIVE above BACK in the bottom band. The reading
         wears the amber its band gives it, like the trunk page's own label. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20"
                   Text="{Binding Title}"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="16,0">
            <TextBlock Text="{Binding VenueLine}" Foreground="#FFF" FontSize="15"
                       FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <TextBlock Text="{Binding IntroLine}" Foreground="#FFF" FontSize="15"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding HungerLine}" FontSize="15" FontWeight="Bold"
                       TextAlignment="Center" Margin="0,12,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FF97EAD2"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HungerAmber}" Value="True">
                                <Setter Property="Foreground" Value="#FFFFA600"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Button Content="{Binding StartLabel}" Command="{Binding StartCommand}"
                    Margin="0,0,0,6">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StartFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{loc:Loc Key=DeliveryBack}" Command="{Binding BackCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
