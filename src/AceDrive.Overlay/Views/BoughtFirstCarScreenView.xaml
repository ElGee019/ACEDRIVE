<UserControl x:Class="AceDrive.Overlay.Views.BoughtFirstCarScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Post-purchase page (PORTPLAN 29, Unity BoughtFirstCar): the new car is
         already owned, this page only picks whether it becomes the car that is
         driven. The summary line stays hidden until a second car exists (Unity's
         showSummary gate). -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20" Text="{Binding Title}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Body}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding CarLine}" Foreground="#FFF" FontSize="16" FontWeight="Bold"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding SummaryLine}" Foreground="#FF97EAD2" FontSize="13"
                       TextAlignment="Center" Margin="0,6,0,0"
                       Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,4,0,6">
            <Button Content="{loc:Loc Key=BoughtDrive}" Command="{Binding DriveCommand}"
                    Padding="12,1" Margin="0,0,10,0"/>
            <Button Content="{loc:Loc Key=BoughtKeep}" Command="{Binding KeepCommand}"
                    Padding="12,1"/>
        </StackPanel>
    </Grid>
</UserControl>
