<UserControl x:Class="AceDrive.Overlay.Views.ValuationBriefingScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- The weekly market valuation's briefing page (PORTPLAN 49): what the
         calendar's Monday row opens before the companion pins the venue. Unity
         has no such page — its job-centre button starts the drive at once — so
         the port spells the week's terms out before a leg that cannot be
         cancelled. Same skeleton as the missing-person page: title band, body,
         the verbs flush at the bottom (START above BACK, the valuation
         showcase's own order). The body takes the middle of the panel so the
         text sits centred instead of hugging the title. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20"
                   Text="{Binding Title}"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="16,0">
            <!-- Where the showcase is held, then the terms of the week: the
                 same body size as the missing-person page's intro. -->
            <TextBlock Text="{Binding VenueLine}" Foreground="#FF97EAD2" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding IntroLine}" Foreground="#FFF" FontSize="15"
                       TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Verb band: START DRIVE rides above BACK, both flush with the panel
             edge like the showcase page; teal is the shared voice-ack
             highlight. -->
        <StackPanel Grid.Row="2">
            <Button Content="{Binding StartLabel}" Command="{Binding StartCommand}"
                    Padding="4" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StartFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{loc:Loc Key=ValuationBack}" Command="{Binding BackCommand}"
                    Padding="4" HorizontalAlignment="Stretch">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
