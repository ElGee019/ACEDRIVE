<UserControl x:Class="AceDrive.Overlay.Views.VoiceInfoScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Same page skeleton as DialogueScreenView: viewport-pinned MinHeight,
         title row at a fixed height, body centered below it. The button sits
         in its own bottom row: the inner border's 10 px padding leaves exactly
         the same gap to the edge line as the title has at the top. The *2*/*
         column split below centres it at half the text column's width. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="{loc:Loc Key=VoiceInfoTitle}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- One paragraph, one idea per line: no blank line between them. -->
            <TextBlock Text="{Binding LeadText}" Foreground="#FFF" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,6,0,6"/>
            <TextBlock Text="{Binding DetailText}" Foreground="#FFF" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,6"/>
        </StackPanel>
        <!-- The next step sits at the bottom of the page, one blank line above
             the button. Pages without one collapse the row. -->
        <TextBlock Grid.Row="2" Text="{Binding HintText}" Foreground="#FFF" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,0,0,19"
                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{loc:Loc Key=DialogueContinue}" Padding="4"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ContinueCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <!-- Teal voice-ack glow, same as the dialogue
                                 pages' Continue: the VM lights it while the
                                 beat runs before ShowDialogue flips. -->
                            <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
