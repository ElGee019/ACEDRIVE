<UserControl x:Class="AceDrive.Overlay.Views.FuelReceiptScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization">
    <!-- Fuel receipt page skeleton like the other receipts: viewport-pinned
         MinHeight, title row, body centered below it, CONTINUE in the bottom
         row. The body mirrors Unity FuelStationScreen's result block: litres
         added, the pump's CR/L, the amount taken (teal), the free-card note
         when a reward covered it, the attendant's new familiarity and the
         wallet it drew from (debt is possible: the fuel was already pumped). -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20" Text="{Binding Title}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Grid.IsSharedSizeScope="True">
            <TextBlock Text="{Binding LitresLine}" Foreground="#FFF" FontSize="18"
                       TextAlignment="Center" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding PriceLine}" Foreground="#FFF" FontSize="16"
                       TextAlignment="Center" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding PaidLine}" Foreground="#FF97EAD2" FontSize="20"
                       TextAlignment="Center" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding FreeLine}" Foreground="#FF97EAD2" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasFree, Converter={StaticResource BoolToVis}}"/>
            <!-- The roadside repair already paid for these litres (PORTPLAN
                 38): the pump bill is only the remainder. -->
            <TextBlock Text="{Binding PrepaidLine}" Foreground="#FF97EAD2" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasPrepaid, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding FriendshipLine}" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasFriendship, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FriendshipHighlight}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding WalletLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" Margin="0,0,0,4"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{loc:Loc Key=ReceiptContinue}" Padding="4"
                    HorizontalAlignment="Stretch" Command="{Binding ContinueCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
