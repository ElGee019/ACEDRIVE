<UserControl x:Class="AceDrive.Overlay.Views.ShiftEndedScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AceDrive.Overlay.Localization"
             xmlns:views="clr-namespace:AceDrive.Overlay.Views">
    <!-- Shift-ended page (PORTPLAN 12, Unity ShiftEndedScreen): the shift
         that just timed out, then the lifetime records and the shift world
         standings. Same skeleton as the receipts: viewport-pinned MinHeight,
         title row, body centered, CONTINUE in the bottom row. -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" FontSize="20" Text="{loc:Loc Key=ShiftEndedTitle}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding JobsLine}" Foreground="#FFF" FontSize="18"
                       TextAlignment="Center" Margin="0,6,0,2"/>
            <TextBlock Text="{Binding EarningsLine}" Foreground="#FF97EAD2" FontSize="20"
                       TextAlignment="Center" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding DurationLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock Text="{Binding LongestLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding BestLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding TotalShiftsLine}" Foreground="#FFBFC4C9" FontSize="14"
                       TextAlignment="Center" Margin="0,0,0,14"/>
            <!-- Best-single-shift world standings (Unity ShiftStandingsService):
                 rank line + delta line, same pulse and teal delta colour as the
                 receipt's XP block. -->
            <views:StandingsLine Text="{Binding Standings.Line}"
                                 PulseSignal="{Binding Standings.PulseSignal}"
                                 Foreground="#FFF" FontSize="16" TextAlignment="Center"/>
            <TextBlock Text="{Binding Standings.DeltaLine}" FontSize="14"
                       TextAlignment="Center" Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Standings.Changed}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{loc:Loc Key=ReceiptContinue}" Padding="4"
                    HorizontalAlignment="Stretch" Command="{Binding ContinueCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ContinueFlash}" Value="True">
                                <Setter Property="Foreground" Value="#FF97EAD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
